# Public address the site is served from (no trailing slash). Used for
# canonical URLs, the sitemap, robots.txt and social-sharing previews.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (https://resend.com). Without these three values the
# form tells visitors it could not send, rather than silently dropping messages.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# AI chatbot (Google Gemini via Genkit).
GOOGLE_GENAI_API_KEY=
